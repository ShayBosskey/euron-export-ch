# Sanity CMS — copy this file to .env.local and fill in your values
# Create a free project at https://www.sanity.io/manage

NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Read-only token for server-side draft previews (optional)
SANITY_API_READ_TOKEN=your_read_token_here

# ── NextAuth (Garage Portal) ───────────────────────────────────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_32_byte_random_string

# ── ERPNext Backend ───────────────────────────────────────────────────────────
# Users log in with their own Frappe account; the Frappe session (sid + CSRF) stays in the
# encrypted NextAuth cookie and is never sent to the browser (src/lib/erp, src/lib/auth.ts).
# https required; http only for localhost in development.
# Default = local devcontainer ERP. Production (Vercel env): ERPNEXT_BASE_URL=https://erp.euron-export.ch
ERPNEXT_BASE_URL=http://localhost:8000
# Integration user — reserved for the public inventory read (ERP-21/FE-10). Not used by any code
# yet: the driver page and the pickup action call the ERP as the logged-in user (FE-02/FE-01).
ERPNEXT_API_KEY=your_erpnext_api_key
ERPNEXT_API_SECRET=your_erpnext_api_secret
